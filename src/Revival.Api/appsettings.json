{
  "Database": {
    "Provider": "Sqlite",
    "SqlitePath": "./data/revival.db"
  },
  "Storage": {
    "AssetRoot": "./data/assets",
    "BackupRoot": "./data/backups"
  },
  "Security": {
    "AdminBootstrapSecret": ""
  },
  "RateLimits": {
    "AuthPerMinute": 10,
    "RequestsPerMinute": 300
  },
  "Rooms": {
    "CleanupIntervalSeconds": 15,
    "MembershipTimeoutSeconds": 90,
    "MatchmakingTimeoutSeconds": 180
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
